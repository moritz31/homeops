{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':dependencyDashboard',
    ':semanticCommits',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/Berlin',
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  commitBodyTable: true,
  flux: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      description: 'Auto-merge low urgency media applications each week',
      matchFileNames: [
        'kubernetes/apps/default/jellyfin/**',
        'kubernetes/apps/default/radarr/**',
        'kubernetes/apps/default/sonarr/**',
      ],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'low urgency media applications',
      groupSlug: 'low-urgency-media-applications',
      schedule: ['* 0-3 * * 1'],
      minimumReleaseAge: '3 days',
      automerge: true,
      automergeType: 'pr',
      automergeSchedule: ['* 0-3 * * 1'],
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: 'Collect routine infrastructure updates for weekly review',
      matchFileNames: [
        'kubernetes/bootstrap/**',
        'kubernetes/flux/**',
        'kubernetes/apps/agones-system/**',
        'kubernetes/apps/cert-manager/**',
        'kubernetes/apps/flux-system/**',
        'kubernetes/apps/kube-system/**',
        'kubernetes/apps/monitoring/**',
        'kubernetes/apps/networking/**',
        'kubernetes/apps/default/cloudnative-pg/**',
      ],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'low urgency infrastructure',
      groupSlug: 'low-urgency-infrastructure',
      schedule: ['* 0-3 * * 1'],
      automerge: false,
    },
    {
      description: 'Keep Flux pins synchronized and require migration approval',
      matchPackageNames: [
        'fluxcd/flux2',
        'ghcr.io/fluxcd/flux-manifests',
      ],
      groupName: 'Flux',
      groupSlug: 'flux',
      schedule: ['at any time'],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: 'Keep GitHub Actions updates in their own weekly group',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'GitHub Actions',
      groupSlug: 'github-actions',
      schedule: ['* 0-3 * * 1'],
      minimumReleaseAge: '3 days',
      automerge: true,
      automergeType: 'pr',
      automergeSchedule: ['* 0-3 * * 1'],
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: 'Require explicit approval for major updates',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      automerge: false,
    },
  ],
}
